{
    "kind": "FIXTURE",
    "document": {
        "schemaVersion": "1.0",
        "prepare": {
            "method": "POST",
            "path": "/prepare"
        },
        "query": {
            "method": "GET",
            "path": "/query"
        },
        "cleanup": {
            "method": "POST",
            "path": "/cleanup"
        },
        "inputSchema": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "required": [
                "name"
            ],
            "additionalProperties": false
        },
        "outputSchema": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string"
                }
            },
            "required": [
                "code"
            ],
            "additionalProperties": false
        },
        "ttlSeconds": 1800
    }
}
