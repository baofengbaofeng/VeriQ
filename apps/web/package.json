{
    "name": "@veriq/web",
    "dependencies": {
        "@dnd-kit/core": "6.3.1",
        "@radix-ui/react-dialog": "1.3.1",
        "@radix-ui/react-dropdown-menu": "2.2.1",
        "@radix-ui/react-select": "2.4.1",
        "@radix-ui/react-tooltip": "1.4.1",
        "@tanstack/react-query": "5.107.1",
        "@tanstack/react-table": "8.21.3",
        "@veriq/contracts": "workspace:*",
        "@veriq/ui": "workspace:*",
        "class-variance-authority": "0.7.1",
        "dompurify": "3.4.17",
        "eventsource-parser": "4.1.3",
        "i18next": "25.10.10",
        "marked": "18.2.1",
        "monaco-editor": "0.57.0",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "react-hook-form": "7.91.0",
        "react-i18next": "16.6.6",
        "react-router-dom": "7.18.5"
    },
    "devDependencies": {
        "@playwright/test": "1.65.0",
        "@types/node": "24.10.1",
        "@types/react": "18.3.31",
        "@types/react-dom": "18.3.7",
        "@vitejs/plugin-react": "4.7.0",
        "tailwindcss": "3.4.19",
        "tough-cookie": "6.1.0",
        "tsx": "4.23.15",
        "typescript": "5.9.3",
        "undici": "7.30.2",
        "vite": "6.4.5"
    },
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "license": "AGPL-3.0-only",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "check": "tsc --noEmit && biome lint src tests vite.config.ts playwright.config.ts && prettier --check src tests vite.config.ts playwright.config.ts",
        "test:e2e": "pnpm test:unit && playwright test",
        "build:desktop": "pnpm build:desktop:types && vite build --config vite.desktop.config.ts",
        "build:desktop:types": "tsc -p tsconfig.desktop.json",
        "test:unit": "node --import tsx --test --test-concurrency=1 tests/unit/*.ts"
    },
    "exports": {
        "./desktop": {
            "types": "./dist-desktop/types/desktop.d.ts",
            "import": "./dist-desktop/index.js"
        },
        "./desktop.css": "./dist-desktop/web.css"
    }
}
