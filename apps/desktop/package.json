{
    "name": "@veriq/desktop",
    "dependencies": {
        "@electron/fuses": "1.8.0",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "@tanstack/react-query": "5.107.1",
        "i18next": "25.10.10",
        "react-i18next": "16.6.6",
        "@veriq/contracts": "workspace:*",
        "@veriq/ui": "workspace:*",
        "ajv": "8.18.0",
        "ajv-formats": "3.0.1",
        "@veriq/runtime": "workspace:*",
        "@veriq/web": "workspace:*",
        "@playwright/test": "1.65.0",
        "@veriq/compiler": "workspace:*",
        "@veriq/runner-sdk": "workspace:*",
        "commander": "14.0.3",
        "env-paths": "3.0.0",
        "pino": "10.4.0",
        "proper-lockfile": "4.1.2",
        "yauzl": "3.4.0",
        "tsx": "4.23.15",
        "playwright-core": "1.65.0",
        "tar": "7.5.22"
    },
    "devDependencies": {
        "vite": "6.4.5",
        "@vitejs/plugin-react": "4.7.0",
        "tailwindcss": "3.4.19",
        "@types/react": "18.3.31",
        "@types/react-dom": "18.3.7",
        "typescript": "5.9.3",
        "@types/node": "24.10.1",
        "electron": "45.3.1",
        "electron-builder": "26.18.1",
        "electron-vite": "6.0.0",
        "@types/proper-lockfile": "4.1.4",
        "@types/yauzl": "3.4.0"
    },
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "license": "AGPL-3.0-only",
    "main": "out/main/index.js",
    "scripts": {
        "build": "pnpm --filter @veriq/web build:desktop && pnpm --filter @veriq/runtime build:launcher && electron-vite build && node scripts/stage-runtime.mjs",
        "check": "pnpm --filter @veriq/web build:desktop:types && tsc -p tsconfig.host.json && tsc -p tsconfig.renderer.json",
        "test:unit": "node --import tsx --test tests/*.test.ts",
        "test:e2e": "playwright test --config playwright.config.ts"
    }
}
