{
  "openapi": "3.1.0",
  "info": {
    "title": "VeriQ controlled demo backend",
    "version": "1.0.0",
    "description": "Tested Python/Tornado sample. Three independent externally supplied identities. No internal scheduler; no test barrier routes in this application."
  },
  "paths": {
    "/prepare": {
      "post": {
        "summary": "Idempotent isolated fixture preparation",
        "security": [
          {
            "FixtureBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful JSON result"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Missing identity"
          },
          "403": {
            "description": "Wrong identity"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Changed idempotency parameters or closed namespace"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "workspaceId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "caseExecutionId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "attemptNo": {
                    "type": "integer",
                    "enum": [
                      1,
                      2
                    ]
                  },
                  "namespace": {
                    "type": "string",
                    "minLength": 1
                  },
                  "idempotencyKey": {
                    "type": "string",
                    "minLength": 1
                  },
                  "input": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "name"
                    ],
                    "additionalProperties": false
                  },
                  "ttlSeconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 604800
                  }
                },
                "required": [
                  "workspaceId",
                  "caseExecutionId",
                  "attemptNo",
                  "namespace",
                  "idempotencyKey",
                  "input",
                  "ttlSeconds"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
