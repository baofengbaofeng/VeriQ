{
    "kind": "CASE",
    "document": {
        "schemaVersion": "1.0",
        "caseKey": "employee-create",
        "title": "Create and reload a persisted employee",
        "kind": "WRITE",
        "roleKey": "editor",
        "catalogVersionId": "00000001-0001-4001-8001-000000000001",
        "fixtureVersionId": "00000003-0003-4003-8003-000000000003",
        "datasetVersionId": "00000002-0002-4002-8002-000000000002",
        "fixtureInput": {
            "name": "{{data.name}}"
        },
        "persistenceCheckpointStepId": "confirm",
        "steps": [
            {
                "id": "open",
                "action": "goto",
                "path": "/?code={{vars.code}}"
            },
            {
                "id": "name-flow",
                "action": "callFlow",
                "versionId": "00000004-0004-4004-8004-000000000004",
                "parameters": {
                    "name": "{{data.name}}"
                }
            },
            {
                "id": "save",
                "action": "click",
                "target": "employee.form.save",
                "critical": true,
                "observers": [
                    {
                        "id": "create",
                        "method": "POST",
                        "path": "/employees",
                        "bodyMatch": {
                            "code": "{{vars.code}}",
                            "name": "{{data.name}}"
                        },
                        "timeoutMs": 15000,
                        "window": {
                            "mode": "UNTIL_ACTION_SETTLED",
                            "quietMs": 500
                        }
                    }
                ],
                "afterAssertions": [
                    {
                        "id": "http",
                        "type": "httpStatus",
                        "severity": "BLOCK",
                        "expectedSource": "DEMO-EMPLOYEE-1",
                        "source": "response:create",
                        "operator": "equals",
                        "expected": 200
                    },
                    {
                        "id": "business",
                        "type": "responseField",
                        "severity": "BLOCK",
                        "expectedSource": "DEMO-EMPLOYEE-1",
                        "source": "response:create",
                        "pointer": "/status",
                        "operator": "equals",
                        "expected": "CREATED"
                    }
                ],
                "extract": [
                    {
                        "source": "response:create",
                        "pointer": "/id",
                        "to": "employeeId",
                        "valueType": "string",
                        "required": true
                    }
                ]
            },
            {
                "id": "confirm",
                "action": "reload",
                "afterAssertions": [
                    {
                        "id": "persisted-name",
                        "type": "ui",
                        "severity": "BLOCK",
                        "expectedSource": "DEMO-EMPLOYEE-1",
                        "target": "employee.row.name",
                        "operator": "textEquals",
                        "expected": "{{data.name}}",
                        "timeoutMs": 10000
                    },
                    {
                        "id": "stored-id",
                        "type": "eventually",
                        "severity": "BLOCK",
                        "expectedSource": "DEMO-EMPLOYEE-1",
                        "query": {
                            "method": "GET",
                            "path": "/employees",
                            "query": {
                                "code": "{{vars.code}}"
                            }
                        },
                        "pointer": "/items/0/id",
                        "operator": "equals",
                        "expected": "{{vars.employeeId}}",
                        "timeoutMs": 10000,
                        "intervalMs": 250
                    }
                ]
            }
        ]
    }
}
