{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "types": ["node"]
    },
    "include": [
        "tests/**/*.ts",
        "tests/**/*.mts",
        "fixtures/**/*.ts",
        "fixtures/**/*.tsx",
        "fixtures/**/*.mts",
        "packages/ui/src/**/*.tsx"
    ]
}
