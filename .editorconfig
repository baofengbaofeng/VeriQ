# VeriQ editor defaults: keep indentation and newlines consistent across languages.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{py,ts,tsx,js,jsx,mjs,cjs,c,h,cpp,hpp,json,yml,yaml,md,toml}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
